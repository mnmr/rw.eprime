<Project>
  <!-- Each host embeds the single shared catalog; no separately installed mod. -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Languages/**/*.xml">
      <LogicalName>RimShared.Translations.Languages.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)FallbackLanguages/**/*.xml">
      <LogicalName>RimShared.Translations.FallbackLanguages.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
