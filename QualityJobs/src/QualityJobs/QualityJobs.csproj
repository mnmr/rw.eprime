<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net472</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>QualityJobs</RootNamespace>
    <AssemblyName>QualityJobs</AssemblyName>
    <OutputPath>..\..\mod\$(RimWorldVersion)\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>portable</DebugType>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RimSharedRoot)\UiLib\**\*.cs" LinkBase="Shared" />
    <Compile Include="$(RimSharedRoot)\GameLib\Localization\**\*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" Condition="'$(RimWorldVersion)' == '1.6'" />
    <PackageReference Include="Lib.Harmony" Version="2.*" Condition="'$(RimWorldVersion)' == '1.6'" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" Condition="'$(RimWorldVersion)' == '1.6'" PrivateAssets="all" />
    <PackageReference Include="RimWorld.MultiplayerAPI" Version="0.6.0" Condition="'$(RimWorldVersion)' == '1.6'" />
    <!-- Use the API assembly without its transitive Unity 1.6 reference package. -->
    <PackageDownload Include="RimWorld.MultiplayerAPI" Version="[0.6.0]" Condition="'$(RimWorldVersion)' == '1.7'" />
    <Reference Include="0MultiplayerAPI" HintPath="$(NuGetPackageRoot)rimworld.multiplayerapi/0.6.0/lib/net472/0MultiplayerAPI.dll" Condition="'$(RimWorldVersion)' == '1.7'" />
    <ProjectReference Include="..\QualityJobs.Core\QualityJobs.Core.csproj" />
  </ItemGroup>
  <Import Project="$(RimSharedRoot)/Build/RimWorld17.props" Condition="'$(RimWorldVersion)' == '1.7'" />
  <Import Project="$(RimSharedRoot)/Translations/Translations.props" />
</Project>
