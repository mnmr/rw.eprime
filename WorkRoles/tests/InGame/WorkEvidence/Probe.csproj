<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net472</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <LangVersion>10</LangVersion><AssemblyName>WorkRoles.WorkEvidenceProbe</AssemblyName><OutputPath>Probe/$(RimWorldVersion)/Assemblies/</OutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath><GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Baseline)' == 'true'"><DefineConstants>$(DefineConstants);BASELINE</DefineConstants><OutputPath>BaselineProbe/$(RimWorldVersion)/Assemblies/</OutputPath></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" Condition="'$(RimWorldVersion)' == '1.6'" />
    <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" Condition="'$(RimWorldVersion)' == '1.6'" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(RimWorldVersion)' == '1.6'" />
    <Reference Include="System.Xml.Linq" Condition="'$(RimWorldVersion)' == '1.6'" />
    <Reference Include="WorkRoles" HintPath="../../../mod/$(RimWorldVersion)/Assemblies/WorkRoles.dll" Private="false" />
    <Reference Include="WorkRoles.Core" HintPath="../../../mod/$(RimWorldVersion)/Assemblies/WorkRoles.Core.dll" Private="false" />
  </ItemGroup>
  <Import Project="../../../../Shared/Build/RimWorld17.props" Condition="'$(RimWorldVersion)' == '1.7'" />
  <Target Name="BaselineMetadata" AfterTargets="Build" Condition="'$(Baseline)' == 'true'">
    <MakeDir Directories="BaselineProbe/About" />
    <Copy SourceFiles="Probe/About/About.xml" DestinationFolder="BaselineProbe/About" />
  </Target>
</Project>
