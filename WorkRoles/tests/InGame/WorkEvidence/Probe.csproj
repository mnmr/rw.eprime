<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net472</TargetFramework><LangVersion>10</LangVersion><AssemblyName>WorkRoles.WorkEvidenceProbe</AssemblyName><OutputPath>Probe/1.6/Assemblies/</OutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath><GenerateDependencyFile>false</GenerateDependencyFile></PropertyGroup>
  <PropertyGroup Condition="'$(Baseline)' == 'true'"><DefineConstants>$(DefineConstants);BASELINE</DefineConstants><OutputPath>BaselineProbe/1.6/Assemblies/</OutputPath></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
    <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="WorkRoles" HintPath="../../../mod/1.6/Assemblies/WorkRoles.dll" Private="false" />
    <Reference Include="WorkRoles.Core" HintPath="../../../mod/1.6/Assemblies/WorkRoles.Core.dll" Private="false" />
  </ItemGroup>
  <Target Name="BaselineMetadata" AfterTargets="Build" Condition="'$(Baseline)' == 'true'">
    <MakeDir Directories="BaselineProbe/About" />
    <Copy SourceFiles="Probe/About/About.xml" DestinationFolder="BaselineProbe/About" />
  </Target>
</Project>
