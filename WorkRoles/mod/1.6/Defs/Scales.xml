<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Shipped holder scales (12 colony-size bands of 3: 1-3 .. 34+). Roles
       reference them by label via RoleDef.holderScale; several roles can share
       one scale. Seeded once per save as editable scales; max omitted =
       uncapped. -->

